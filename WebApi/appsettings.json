{
  "AllowedHosts": "*",
  "Auth": {
    "SigningKey": "this key should be set via environment variable in production",
    "IdentityOptions": {
      "Password": {
        "RequireDigit": false,
        "RequiredLength": 8,
        "RequireNonAlphanumeric": false,
        "RequireUppercase": false,
        "RequireLowercase": false
      },
      "Lockout": {
        "AllowedForNewUsers": true,
        "MaxFailedAccessAttempts": 5,
        "DefaultLockoutTimeSpan": "00:05:00"
      },
      "SignIn": {
        "RequireConfirmedEmail": false,
        "RequireConfirmedPhoneNumber": false
      },
      "User": {
        "RequireUniqueEmail": true
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=./Database/database.sqlite"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [
      "en-US",
      "id-ID"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "WebApi",
      "Environment": "Development",
      "Version": "1.0.0"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:O} {CorrelationId} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/app-.log",
          "RollingInterval": "Day",
          "RetainedFileCountLimit": 30,
          "Formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/errors-.log",
          "RollingInterval": "Day",
          "RetainedFileCountLimit": 90,
          "RestrictedToMinimumLevel": "Error",
          "OutputTemplate": "[{Timestamp:O} {CorrelationId} {Level:u3}] {Message:lj} <s:{SourceContext}> <props:{Properties}>{NewLine}{Exception}"
        }
      }
    ]
  },
  "Swagger": {
    "IsDevelopmentOnly": true,
    "DocumentOptions": [
      {
        "MaxEndpointVersion": 1,
        "MinEndpointVersion": 1,
        "DocumentSettings": {
          "DocumentName": "v1",
          "Version": "v1"
        }
      },
      {
        "MaxEndpointVersion": 2,
        "MinEndpointVersion": 2,
        "DocumentSettings": {
          "DocumentName": "v2",
          "Version": "v2"
        }
      }
    ]
  }
}